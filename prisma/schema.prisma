generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  language     String   @default("en")
  photoUrl     String?
  isPremium    Boolean  @default(false)
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens         RefreshToken[]
  passwordResetRequests PasswordResetRequest[]
  reports               Report[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PendingRegistration {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  fullName         String
  language         String   @default("en")
  codeHash         String
  expiresAt        DateTime
  attemptCount     Int      @default(0)
  lastSentAt       DateTime
  pendingExpiresAt DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([expiresAt])
  @@index([pendingExpiresAt])
}

model PasswordResetRequest {
  id           String    @id @default(uuid())
  userId       String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ReportStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
}

enum ReportAssetType {
  IMAGE
  AUDIO
  DOCUMENT
}

enum ReportAssetStatus {
  PENDING_UPLOAD
  READY
  REJECTED
}

enum StorageCleanupReason {
  ASSET_DELETE
  REPORT_DELETE
  REJECTED_UPLOAD
  EXPIRED_UPLOAD
}

model Report {
  id        String       @id @default(uuid())
  userId    String
  title     String
  notes     String?
  status    ReportStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets ReportAsset[]

  @@index([userId, createdAt(sort: Desc)])
}

model ReportAsset {
  id                String            @id @default(uuid())
  reportId          String
  type              ReportAssetType
  status            ReportAssetStatus @default(PENDING_UPLOAD)
  storageKey        String            @unique
  originalFileName  String
  declaredMimeType  String
  verifiedMimeType  String?
  declaredSize      Int
  verifiedSize      Int?
  position          Int
  width             Int?
  height            Int?
  durationSeconds   Float?
  rejectionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, position])
  @@index([status, createdAt])
}

model StorageCleanupTask {
  id            String               @id @default(uuid())
  storageKey    String               @unique
  reason        StorageCleanupReason
  attemptCount  Int                  @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([createdAt])
}
